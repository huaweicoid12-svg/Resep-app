# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env ke repository.

APP_NAME=ResepApp
APP_ENV=production
# Generate dengan:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (MySQL). Host "db" = nama service di compose.yaml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=resep_db
DB_USERNAME=resep_user
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_root_password_kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# true = isi 6 resep contoh saat tabel masih kosong
RUN_SEEDER=true
